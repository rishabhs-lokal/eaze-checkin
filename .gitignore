# Secrets — never commit real values. backend/.env.example stays tracked
# as the template; backend/.env (and any other .env variant) is where real
# local secrets like EAZE_COINS_AUTH_KEY actually live.
.env
.env.*
!.env.example
!*.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS/editor cruft
.DS_Store
