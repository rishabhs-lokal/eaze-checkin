APP_ENV=local
LOG_LEVEL=info
DATABASE_URL=postgresql://eaze:eaze@localhost:5432/eaze
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Leave unset locally -> claims run in mock mode (no real transfer call).
EAZE_COINS_AUTH_KEY=
EAZE_COINS_API_URL=https://api.eazeapp.com/payments/free-coins/upload/

# Shared, cross-app EazeScore ledger (eaze-level-up's own backend). Leave as
# the host.docker.internal default for local dev — that's how this
# container reaches eaze-level-up's separate docker-compose project running
# on the host's port 3000. Leave empty to disable mirroring entirely.
EAZE_LEVEL_UP_API_URL=http://host.docker.internal:3000

# Engagement-only (yes/no) note logging into text_log — never stores note
# text, so this defaults to true. Set to false to disable it entirely.
TEXT_LOG_ENABLED=true

# Redash API key for query 20342 (phone lookup by eaze_user_id) — the
# banner-entry fallback used when a banner link omits ?phone=. Leave blank
# to disable the lookup entirely (frontend falls back to the typed-phone
# login screen instead).
REDASH_API_KEY=
